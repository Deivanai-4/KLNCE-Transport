# ============================================================
# KLNCE Smart Transport System — Backend Environment Variables
# Copy this file to .env for local development.
# On Render: set these as Environment Variables in the dashboard.
# NEVER commit the actual .env file to Git.
# ============================================================

# --- Flask Security (REQUIRED — change before production) ---
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=change-this-to-a-different-random-jwt-secret-32-chars

# --- JWT Token Expiry ---
# Number of days before JWT tokens expire. Default is 30.
# Set to 0 to disable expiry (development only — NOT for production).
JWT_ACCESS_TOKEN_EXPIRES_DAYS=30

# --- MongoDB Atlas (REQUIRED) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=klnce_transport

# --- App Environment ---
# Options: development | production | testing
FLASK_ENV=production

# --- CORS ---
# For production: set to your specific domain(s), e.g. https://klnce-transport.onrender.com
# For development: * is acceptable
CORS_ORIGINS=*

# --- File Upload ---
UPLOAD_FOLDER=uploads
# Max upload size in bytes (default: 10 MB)
MAX_CONTENT_LENGTH=10485760

# --- Firebase (optional — only needed for push notifications) ---
# Path to Firebase service account JSON file, OR base64-encoded JSON content
FIREBASE_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# --- Google Maps (optional — only needed for GPS tracking screen) ---
GOOGLE_MAPS_API_KEY=

# --- Port (Render sets this automatically — do not override on Render) ---
# PORT=5000
